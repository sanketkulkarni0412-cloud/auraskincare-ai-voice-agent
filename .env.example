# Aura Skincare AI Voice Agent — Environment Configuration
# Copy this file to .env.local and populate with your credentials.

# Google Gemini API Key (Required for live Gemini AI customer-support chat & tool calling)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional Gemini model identifier (Defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional Voice / Audio Providers (Browser Web Speech API is used by default if empty)
OPENAI_API_KEY=
